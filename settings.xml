<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Every build here runs with "-s settings.xml", so anything a build needs has to be here. It needs nothing
         but Central: this pom uses nothing of another Porelo repository. Only the workflows' release tooling, the
         ci-tools profile, is a snapshot of porelo-buildtools, read under the profile below. -->

    <servers>

        <!-- Where the central-sonatype-release profile publishes. Values come from the environment; nothing
             secret is in this file. -->
        <server>
            <id>central-sonatype</id>
            <username>${env.OSS_SONATYPE_USERNAME}</username>
            <password>${env.OSS_SONATYPE_TOKEN}</password>
        </server>

        <!-- Where the forge-release profile deploys: the local forge's Maven registry, as porelo-publisher. -->
        <server>
            <id>porelo-forge</id>
            <username>porelo-publisher</username>
            <password>${env.PORELO_PUBLISHER_TOKEN}</password>
        </server>

    </servers>

    <profiles>

        <!-- The release tooling's snapshot, from Central's snapshots. Only the groups listed in .mvn/rrf/ are asked of
             that repository, under this profile's id, with the filter the workflow switches on; Central is asked as
             before. Nothing but a workflow's -Pbuildtools-snapshots turns it on, so the Build reads Central alone. -->

        <profile>

            <id>buildtools-snapshots</id>

            <repositories>

                <repository>
                    <id>central.sonatype.snapshots</id>
                    <name>Central Sonatype Snapshot Repository</name>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <updatePolicy>always</updatePolicy>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>

            </repositories>

        </profile>

    </profiles>

</settings>
